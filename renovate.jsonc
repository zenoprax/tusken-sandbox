{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "recreateClosed": true,
  "automergeType": "branch",
  "ignoreTests": true,
  "pruneBranchAfterAutomerge": true,
  "semanticCommits": "enabled",
  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "dockerfile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "packageNameTemplate": "anomalyco/opencode",
      "versioningTemplate": "loose",
      "matchStrings": [
        "ARG OPENCODE_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "anomalyco/opencode"
      ],
      "automerge": true,
      "allowedVersions": "/^v?1\\.18\\./"
    },
    {
      "matchPackageNames": [
        "quay.io/fedora/fedora-minimal"
      ],
      "automerge": false,
      "automergeType": "pr",
      "allowedVersions": "/^4[45](\\.|$)/"
    }
  ]
}