{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "recreateWhen": "always",
  "automergeType": "branch",
  "pruneBranchAfterAutomerge": true,
  "semanticCommits": "enabled",
  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "dockerfile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "OpenCode",
      "packageNameTemplate": "anomalyco/opencode",
      "versioningTemplate": "semver",
      "matchStrings": [
        "ARG OPENCODE_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions",
      "commitMessageTopic": "GitHub Action {{{depName}}}"
    },
    {
      "matchManagers": ["dockerfile"],
      "semanticCommitType": "build",
      "semanticCommitScope": "container",
      "commitMessageAction": "Refresh",
      "commitMessageTopic": "base image",
      "commitMessageLowerCase": "never"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["anomalyco/opencode"],
      "semanticCommitType": "build",
      "semanticCommitScope": "container",
      "commitMessageTopic": "{{{depName}}}",
      "commitMessageLowerCase": "never"
    },
    {
      "matchPackageNames": ["anomalyco/opencode"],
      "matchUpdateTypes": ["minor", "major"],
      "commitMessageAction": "Upgrade",
      "draftPR": false,
      "addLabels": ["manual-review"],
      "changelogUrl": "https://opencode.ai/changelog",
      "fetchChangeLogs": "pr",
      "automerge": false
    },
    {
      "matchPackageNames": ["anomalyco/opencode"],
      "matchUpdateTypes": ["patch"],
      "commitMessageAction": "Patch",
      "automerge": true
    }
  ]
}
